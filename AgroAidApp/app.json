{
  "expo": {
    "name": "AgroAid",
    "slug": "agroaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agroaid",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FBF3"
    },
    "ios": {
      "bundleIdentifier": "com.agroaid.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AgroAid usa la camara para analizar etiquetas y consultas del productor.",
        "NSMicrophoneUsageDescription": "AgroAid usa el microfono para registrar consultas por voz.",
        "NSLocationWhenInUseUsageDescription": "AgroAid usa tu ubicacion para mostrar eventos y contexto climatico cercano."
      }
    },
    "android": {
      "package": "com.agroaid.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7FBF3"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
