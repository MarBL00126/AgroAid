   xmpMM:OriginalDocumentID="uuid:2FD427962B2CDE11B3C0D7B23D7D97DE"
   xmpRights:Marked="True">
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Outdoors</rdf:li>
     <rdf:li>Male action scene</rdf:li>
     <rdf:li>Pesticides</rdf:li>
     <rdf:li>Spraying</rdf:li>
     <rdf:li>Termites</rdf:li>
     <rdf:li>Mangoes</rdf:li>
     <rdf:li>Africa</rdf:li>
     <rdf:li>H) Plant protection</rdf:li>
     <rdf:li>Plant diseases</rdf:li>
     <rdf:li>Pests of plants</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">9528</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">1977, Sudan - Spraying a mango tree attacked by termites, using a motorised knapsack sprayer, at the Government plantation of the El Bagaier Scheme in Gezira province, 25 miles south of Khartoum. - - Protection of Fruit Tree Plantations. The UN/Food and Agriculture Organization (FAO) is assisting the Government of Sudan in an emergency spraying programme aimed at the eradication of pests and disease in two pilot areas producing dates, mangoes and citrus totalling 500,000 trees. Under its Technical Cooperation Programme (TCP) FAO has provided the services of a plant protection expert for six months and has furnished 150 motorised knapsack sprayers, 100 wheelbarrow-type sprayers  and 4-wheel drive pickups.  The Department of Plant Protection has provided personnel, chemicals and further spraying equipment.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <xmpMM:DerivedFrom rdf:parseType="Resource"/>
   <xmpMM:History>
