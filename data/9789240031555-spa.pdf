    stRef:documentID="7AF4622C87365ADD7200181D86248AE5"
    stRef:originalDocumentID="7AF4622C87365ADD7200181D86248AE5"/>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Romania</rdf:li>
     <rdf:li>Beach</rdf:li>
     <rdf:li>FAO</rdf:li>
     <rdf:li>Project</rdf:li>
     <rdf:li>Litter</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">PO_ROU_201804140005</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">14 April 2018, Sozopol, Romania - Port inspection of fishing nets. Data provided by the vessel monitoring system (VMS), a satellite-based monitoring system, provides data at regular intervals to fisheries authorities, indicating location, course and speed of vessels. The use of Vessel Monitoring Systems (VMS) increases the potential efficiency of Monitoring Control and Surveillance of fishing vessels (MCS). In the last  few years  several  countries  have  introduced VMS  which  enable  the  activities  of  fishing  vessels  to  be monitored and for such  vessels to actively report on catches to the fisheries management authority.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <xmpRights:UsageTerms>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO GFCM</rdf:li>
    </rdf:Alt>
   </xmpRights:UsageTerms>
   <crs:ToneCurve>
    <rdf:Seq>
     <rdf:li>0, 0</rdf:li>
     <rdf:li>255, 255</rdf:li>
    </rdf:Seq>
   </crs:ToneCurve>
   <crs:ToneCurveRed>
