     <rdf:li>Soil toxicity</rdf:li>
     <rdf:li>Pollution</rdf:li>
     <rdf:li>Pesticides</rdf:li>
     <rdf:li>Africa</rdf:li>
     <rdf:li>T) Pollution</rdf:li>
     <rdf:li>Pollution</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">22984</rdf:li>
    </rdf:Alt>
