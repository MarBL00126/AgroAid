    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   xmp:CreateDate="2009-04-16T15:14:19+02:00"
   xmp:ModifyDate="2019-05-06T12:52:16+02:00"
   xmp:MetadataDate="2019-05-06T12:52:16+02:00"
   xmp:CreatorTool="Adobe Photoshop CS3 Macintosh"
   dc:format="image/jpeg"
   photoshop:Country="Sudan"
   photoshop:Credit="Â©FAO/Franco Mattioli"
   photoshop:City="Gezira, Khartoum."
   photoshop:Headline="&amp;nbsp;"
   photoshop:LegacyIPTCDigest="3773DD2ACE753C839C9A565940FE2B97"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:Source="&amp;nbsp;"
   photoshop:ColorMode="4"
   photoshop:ICCProfile="Coated FOGRA39 (ISO 12647-2:2004)"
   xmpMM:InstanceID="xmp.iid:7a321012-27d1-4146-be06-779efa193bfa"
