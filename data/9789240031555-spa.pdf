   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">View of open air deposit of discarded pesticide cans that are polluting the environment, soil and water nearby. The very high temperatures that are sometimes reached in the area cause the emission of poisonous gases. - - FAO/CILSS Management of Pesticides in the Sahel.</rdf:li>
    </rdf:Alt>
   </dc:description>
